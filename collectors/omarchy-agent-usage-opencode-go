def normalize_reset_at(value: Any, now: dt.datetime) -> str:
    if value is None:
        return ""
    raw = str(value).strip()
    if raw == "":
        return ""
    if raw.isdigit():
        ts = int(raw)
        if ts < 1e12:
            ts *= 1000
        try:
            return dt.datetime.fromtimestamp(ts / 1000, dt.timezone.utc).isoformat()
        except Exception:
            return raw
    try:
        parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        return parsed.isoformat()
    except Exception:
        return raw


def parse_percent(value: Any) -> float:
    # The endpoint reports USED percent on a 0-100 scale. The panel speaks
    # fractions, so scale down and clamp.
    try:
        n = float(value)
    except Exception:
        return -1.0
    if not (n >= 0):
        return -1.0
    return min(1.0, n / 100.0)


def parse_windows(payload: dict[str, Any], now: dt.datetime) -> list[dict[str, Any]]:
    usage = payload.get("usage")
    if not isinstance(usage, dict):
        # Defensive: accept a legacy shape with the windows at top level.
        usage = payload
    out: list[dict[str, Any]] = []
    for key, title, limit in WINDOW_ORDER:
        bucket = usage.get(key)
        if not isinstance(bucket, dict):
            continue
        percent = parse_percent(bucket.get("percent"))
        if percent < 0:
            continue
        if bucket.get("resetsAt") is not None:
            resets_at = normalize_reset_at(bucket.get("resetsAt"), now)
        elif bucket.get("resetsInSeconds") is not None:
            try:
                resets_at = (now + dt.timedelta(seconds=float(bucket.get("resetsInSeconds")))).isoformat()
            except Exception:
                resets_at = ""
        else:
            resets_at = ""
        out.append({
            "label": title,
            "title": title,
            "percent": percent,
            "resetsAt": resets_at,
            "limit": limit,
            "key": key,
            "status": str(bucket.get("status") or ""),
        })
    return out


def api_base() -> str | None:
    # Overridable for mirrors/proxies; plain HTTP is refused outright — the
    # key must never travel unencrypted.
    base = (os.environ.get("OPENCODE_API_BASE_URL") or "https://opencode.ai").strip().rstrip("/")
    if not base.lower().startswith("https://"):
        return None
    return base


def parse_retry_after(headers) -> float | None:
    # Honor the server's asked wait, clamped to something sane; None means
    # "no usable hint" and the caller falls back to the default backoff.
    try:
        raw = headers.get("Retry-After") if headers is not None else None
    except Exception:
        return None
    if raw is None:
        return None
    try:
        secs = float(str(raw).strip())
    except Exception:
        return None  # HTTP-date form: not worth parsing, use the default
    if not (secs > 0):
        return None
    return min(secs, 900)


class _SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
    # Python's default redirect handler forwards every header — including
    # Authorization — to wherever the redirect points, even an http:// URL
    # or a third party. The key must never travel unencrypted or
    # cross-origin, so drop it whenever a redirect leaves the https origin.
    # Same-origin https redirects keep the header (delegated behavior).
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new_req = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new_req is None:
            return None
        old = urllib.parse.urlparse(req.full_url)
        new = urllib.parse.urlparse(new_req.full_url)
        if (old.scheme, old.hostname, old.port) != (new.scheme, new.hostname, new.port):
            new_req.remove_header("Authorization")
        return new_req


def probe_usage(key: str) -> dict[str, Any]:
    base = api_base()
    if base is None:
        return {"ok": False, "refused": True}
    # The endpoint's front door rejects Python-urllib's default UA (403);
    # an honest client name passes.
    request = urllib.request.Request(
        base + "/zen/go/v1/usage",
        headers={
            "Authorization": "Bearer " + key,
            "Accept": "application/json",
            "User-Agent": "opencode-go-usage-widget/1.0",
        },
    )
    opener = urllib.request.build_opener(_SafeRedirectHandler)
    try:
        with opener.open(request, timeout=10) as response:
            payload = json.loads(response.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as error:
        result = {"ok": False, "http_status": error.code}
        if error.code == 429:
            result["retry_after"] = parse_retry_after(error.headers)
        return result
    except Exception:
        # A transport failure reached no server at all — no route, no DNS. Any
        # real answer, including an error status, is a server we should stop
        # pestering; this is not.
        return {"ok": False, "transport": True}
    if not isinstance(payload, dict):
        return {"ok": False, "transport": True}
    return {"ok": True, "payload": payload}


# A cached percentage outlives the probe that measured it, but only until its
# window rolls over: once a window has reset, the figure describes a period
# that is over, and a stale number would misreport an allowance that is now
# untouched.
def limit_window_open(entry: dict[str, Any], now: dt.datetime) -> bool:
    raw = str(entry.get("resetsAt") or "")
    if raw == "":
        return True
    try:
        resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except Exception:
        return True
    if resets_at.tzinfo is None:
        resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
    return resets_at > now


def usable_cached_windows(cached: dict[str, Any]) -> list[dict[str, Any]]:
    # Full window dicts (with limit/status/key) since v0.1.0; older caches
    # only kept stripped limits, which we enrich best-effort from titles so
    # a cache hit never degrades balance, advice, popup, or history.
    entries = cached.get("windows")
    if not isinstance(entries, list):
        entries = [enrich_legacy(e) for e in (cached.get("limits") or []) if isinstance(e, dict)]
    now = dt.datetime.now(dt.timezone.utc)
    return [entry for entry in entries if isinstance(entry, dict) and limit_window_open(entry, now)]


LEGACY_WINDOWS = {
    "Rolling (5-hour)": ("rolling", ROLLING_LIMIT_USD),
    "Weekly": ("weekly", WEEKLY_LIMIT_USD),
    "Monthly": ("monthly", MONTHLY_LIMIT_USD),
}


def enrich_legacy(entry: dict[str, Any]) -> dict[str, Any]:
    out = dict(entry)
    key, limit = LEGACY_WINDOWS.get(str(entry.get("title") or ""), ("", 0.0))
    out.setdefault("key", key)
    out.setdefault("limit", limit)
    out.setdefault("status", "")
    return out


def apply_fallback(result: dict[str, Any], fallback: list[dict[str, Any]]) -> None:
    result["windows"] = fallback
    result["limits"] = [strip_internal(w) for w in fallback]


def strip_internal(entry: dict[str, Any]) -> dict[str, Any]:
    # "key" stays: the panel maps it to localized display titles (other
    # collectors' records simply have no key and keep parsed titles).
    # "limit" stays too: limit rows render remaining dollars from it.
    return {k: v for k, v in entry.items() if k not in ("status",)}


