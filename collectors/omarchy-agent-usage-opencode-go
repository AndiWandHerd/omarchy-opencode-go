    }


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
    if max_age_seconds <= 0 or not path.exists():
        return None
    try:
        if time.time() - path.stat().st_mtime <= max_age_seconds:
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
    # A temp name unique to this writer, not derived from the target: several
    # collectors can run at once, and a shared temp path means the second
    # replace finds the first one's file already moved away.
    handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
        # mkstemp opens at 0600 and it stays that way: probe caches sit next
        # to auth-adjacent state, so owner-only wins over the stock 0644.
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


# ------------------------------------------------------------------ auth key
#
# The key is read into memory only: it goes nowhere but the Authorization
# header of the quota probe, and it is never printed, logged, or stored.


def api_key() -> str:
    env = (os.environ.get("OPENCODE_GO_API_KEY") or "").strip()
    if env:
        return env
    auth_path = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "auth.json"
    try:
        data = json.loads(auth_path.read_text(encoding="utf-8"))
    except Exception:
        data = {}
    if isinstance(data, dict):
        for entry in ("opencode-go", "opencode"):
            node = data.get(entry)
            if isinstance(node, dict):
                key = str(node.get("key") or "").strip()
                if key:
                    return key
    # Last resort for setups where other Go tooling already exports it.
    return (os.environ.get("OPENCODE_API_KEY") or "").strip()


